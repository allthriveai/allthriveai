{
  "checks": {
    "typescript": "cd frontend && npx tsc --noEmit",
    "lint": "docker compose exec -T web ruff check .",
    "test": "docker compose exec -T web python manage.py test --keepdb"
  },
  "maxIterations": 20,
  "maxSessionSeconds": 600,
  "testUrlBase": "http://localhost:3000",
  "contextRotThreshold": {
    "maxStories": 10,
    "maxFilesChanged": 20
  },
  "auth": {
    "loginUrl": "http://localhost:8000/api/v1/auth/test-login/",
    "testUser": "test@test.local",
    "testPassword": "testpass123",
    "usernameSelector": "input[name='email']",
    "passwordSelector": "input[name='password']",
    "submitSelector": "button[type='submit']"
  }
}
